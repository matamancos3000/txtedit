import os
import pandas as pd
from datetime import datetime
from dateutil.relativedelta import relativedelta

# === CONFIGURACIÓN ===

base_paths = {
    "DEV": r"..\DEV\Output\Log",
    "UAT": r"..\UAT\Output\Log",
    "PROD": r"..\PROD\Output\Log"
}

# Número de meses a incluir (ejemplo: 3 = mes actual y 2 anteriores)
num_meses = 3

# Carpeta de salida
output_dir = r"C:\Logs-Reporttoken"
os.makedirs(output_dir, exist_ok=True)

# Encabezados esperados
headers = [
    "Entorno","FECHA","ProgramID","TaskID","MessageID","MSISDN",
    "OperatorID","MOContent1","ContentType","CreatedOn",
    "Cell Number","CIS","FECHA DE NACIMIENTO","TIPO DE CAMPAÑA",
    "FECHA DE TRABAJO","ESTATUS","DETALLES"
]

# Meses en Español
MESES_ES = [
    "ENERO","FEBRERO","MARZO","ABRIL","MAYO","JUNIO",
    "JULIO","AGOSTO","SEPTIEMBRE","OCTUBRE","NOVIEMBRE","DICIEMBRE"
]

# Meses en Inglés
MESES_EN = [
    "JANUARY","FEBRUARY","MARCH","APRIL","MAY","JUNE",
    "JULY","AUGUST","SEPTEMBER","OCTOBER","NOVEMBER","DECEMBER"
]

# === PROCESO ===

df_final = pd.DataFrame(columns=headers)
now = datetime.now()

# Lista de meses a procesar (español e inglés)
meses_a_incluir = []

for i in range(num_meses):
    fecha_mes = now - relativedelta(months=i)
    indice = fecha_mes.month - 1

    meses_a_incluir.append({
        "year": str(fecha_mes.year),
        "months": [
            MESES_ES[indice],
            MESES_EN[indice]
        ]
    })

print("Procesando meses:")
for m in meses_a_incluir:
    print(f"{m['year']} -> {m['months']}")

for entorno, base_path in base_paths.items():

    for mes in meses_a_incluir:

        year = mes["year"]
        file_path = None

        # Buscar primero español y luego inglés
        for month in mes["months"]:

            ruta = os.path.join(base_path, year, month, "log.csv")

            if os.path.exists(ruta):
                file_path = ruta
                break

        if file_path:

            try:
                df = pd.read_csv(
                    file_path,
                    encoding="latin1",
                    usecols=range(16),
                    on_bad_lines="skip"
                )

                # Insertar columna de entorno
                df.insert(0, "Entorno", entorno)

                # Asignar encabezados
                df.columns = headers

                # Agregar al dataframe final
                df_final = pd.concat([df_final, df], ignore_index=True)

                print(f"✔ Procesado: {file_path}")

            except Exception as e:
                print(f"⚠ Error leyendo {file_path}: {e}")

        else:
            print(f"❌ No existe el log para {year} ({', '.join(mes['months'])})")

# Nombre del archivo de salida
meses_texto = "-".join(
    [m["months"][0] for m in meses_a_incluir[::-1]]
)

output_file = os.path.join(
    output_dir,
    f"log-consentrado-{meses_texto}.csv"
)

# Guardar CSV final
df_final.to_csv(
    output_file,
    index=False,
    encoding="utf-8-sig"
)

print(f"\n✅ Archivo concentrado generado en: {output_file}")
