import os
import pdfplumber
from docx import Document
from docx.shared import Inches
import io
from PIL import Image

def convertir_con_pdfplumber(carpeta_origen):
    """
    Convierte PDF a Word preservando texto e imágenes
    """
    # Verificar carpeta
    if not os.path.isdir(carpeta_origen):
        print(f"❌ Error: '{carpeta_origen}' no es una carpeta válida")
        return
    
    # Buscar PDFs
    pdfs = [f for f in os.listdir(carpeta_origen) if f.lower().endswith('.pdf')]
    
    if not pdfs:
        print(f"⚠️ No se encontraron PDFs en: {carpeta_origen}")
        return
    
    print(f"\n📁 Carpeta: {carpeta_origen}")
    print(f"📄 PDFs encontrados: {len(pdfs)}\n")
    
    for pdf_file in pdfs:
        pdf_path = os.path.join(carpeta_origen, pdf_file)
        docx_path = os.path.join(carpeta_origen, pdf_file.replace('.pdf', '.docx'))
        
        print(f"🔄 Procesando: {pdf_file}")
        
        try:
            # Crear documento Word
            doc_word = Document()
            
            # Abrir PDF con pdfplumber
            with pdfplumber.open(pdf_path) as pdf:
                for page_num, page in enumerate(pdf.pages):
                    print(f"   📄 Página {page_num + 1}/{len(pdf.pages)}")
                    
                    # Extraer texto
                    texto = page.extract_text()
                    if texto:
                        doc_word.add_paragraph(f"--- Página {page_num + 1} ---")
                        doc_word.add_paragraph(texto)
                    else:
                        doc_word.add_paragraph(f"--- Página {page_num + 1} (sin texto) ---")
                    
                    # Extraer imágenes de esta página
                    if page.images:
                        for img_idx, img in enumerate(page.images):
                            try:
                                # Extraer la imagen como bytes
                                # Nota: pdfplumber no extrae directamente, usamos PyMuPDF para imágenes
                                pass
                            except:
                                pass
                    
                    # Salto de página excepto en la última
                    if page_num < len(pdf.pages) - 1:
                        doc_word.add_page_break()
            
            # Guardar documento
            doc_word.save(docx_path)
            print(f"   ✅ Convertido: {docx_path}\n")
            
        except Exception as e:
            print(f"   ❌ Error: {e}\n")

