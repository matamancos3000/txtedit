# Script listo para usar - SOLO CAMBIA LA RUTA
import os
import PyPDF2
from docx import Document

CARPETA = r"C:\TU\RUTA\AQUI"  # <--- CAMBIA ESTO

for pdf in [f for f in os.listdir(CARPETA) if f.endswith('.pdf')]:
    pdf_path = os.path.join(CARPETA, pdf)
    docx_path = os.path.join(CARPETA, pdf.replace('.pdf', '.docx'))
    
    doc_word = Document()
    with open(pdf_path, 'rb') as f:
        reader = PyPDF2.PdfReader(f)
        for i, page in enumerate(reader.pages):
            text = page.extract_text()
            doc_word.add_paragraph(f"--- Página {i+1} ---")
            doc_word.add_paragraph(text)
            if i < len(reader.pages)-1:
                doc_word.add_page_break()
    
    doc_word.save(docx_path)
    print(f"✅ {pdf} convertido")
