def verificar_pdf_con_texto(pdf_path):
    """
    Verifica si el PDF contiene texto seleccionable o es solo imágenes
    """
    try:
        import fitz  # PyMuPDF
        
        doc = fitz.open(pdf_path)
        tiene_texto = False
        
        # Revisar primeras páginas en busca de texto
        for pagina_num in range(min(3, len(doc))):
            pagina = doc[pagina_num]
            texto = pagina.get_text().strip()
            if len(texto) > 50:  # Si tiene más de 50 caracteres, asumimos que tiene texto
                tiene_texto = True
                break
        
        doc.close()
        return tiene_texto
        
    except Exception as e:
        print(f"  ⚠️ Error al verificar PDF: {e}")
        return False

def convertir_pdf_con_ocr(pdf_path, docx_path, idioma='spa'):
    """
    Convierte PDF escaneado usando OCR (Tesseract)
    """
    from pdf2image import convert_from_path
    import pytesseract
    from docx import Document
    from PIL import Image
    import tempfile
    import shutil
    
    # Configurar ruta de Tesseract (Windows)
    if sys.platform == "win32":
        # Cambia esta ruta si instalaste Tesseract en otra ubicación
        tesseract_paths = [
            r"C:\Program Files\Tesseract-OCR\tesseract.exe",
            r"C:\Program Files (x86)\Tesseract-OCR\tesseract.exe",
        ]
        for path in tesseract_paths:
            if os.path.exists(path):
                pytesseract.pytesseract.tesseract_cmd = path
                break
    
    # Crear documento Word
    doc_word = Document()
    
    # Convertir PDF a imágenes
    print(f"    📄 Convirtiendo PDF a imágenes...")
    imagenes = convert_from_path(pdf_path, dpi=300)
    
    for i, img in enumerate(imagenes):
        print(f"    🔍 Procesando página {i+1}/{len(imagenes)}...")
        
        # Aplicar OCR a la imagen
        try:
            texto = pytesseract.image_to_string(img, lang=idioma)
            
            # Agregar texto al documento Word
            if i > 0:
                doc_word.add_page_break()
            doc_word.add_paragraph(f"--- Página {i+1} ---")
            
            if texto.strip():
                doc_word.add_paragraph(texto)
            else:
                doc_word.add_paragraph("[Página sin texto detectable]")
                
        except Exception as e:
            doc_word.add_paragraph(f"[Error al procesar página {i+1}: {e}]")
    
    # Guardar documento
    doc_word.save(docx_path)
    return True

def convertir_pdf_normal(pdf_path, docx_path):
    """
    Convierte PDF con texto usando pdf2docx (mantiene formato)
    """
    from pdf2docx import Converter
    
    cv = Converter(pdf_path)
    cv.convert(docx_path, start=0, end=None)
    cv.close()
    return True

def convertir_carpeta_completa(carpeta_origen, carpeta_salida=None, idioma_ocr='spa'):
    """
    Convierte todos los PDFs de una carpeta, detectando automáticamente
    si son escaneados o no
    
    Args:
        carpeta_origen: Ruta de la carpeta con PDFs
        carpeta_salida: Ruta donde guardar los Word (opcional)
        idioma_ocr: Idioma para OCR ('spa', 'eng', 'spa+eng', etc.)
    """
    # Verificar dependencias
    try:
        import fitz
        from pdf2docx import Converter
        from pdf2image import convert_from_path
        import pytesseract
        from docx import Document
        from PIL import Image
    except ImportError as e:
        print(f"❌ Error: Falta instalar una dependencia: {e}")
        print("\n📦 Instala todo con:")
        print("pip install PyMuPDF pdf2docx pdf2image pytesseract python-docx pillow")
        return
    
    # Verificar Tesseract instalado
    try:
        import pytesseract
        pytesseract.get_tesseract_version()
    except Exception:
        print("⚠️  Tesseract no está instalado o no está en el PATH")
        print("   Descárgalo de: https://github.com/UB-Mannheim/tesseract/wiki")
        print("   Para PDFs escaneados, la conversión fallará")
    
    # Validar carpetas
    if not os.path.exists(carpeta_origen):
        print(f"❌ Error: La carpeta '{carpeta_origen}' no existe")
        return
    
    if not os.path.isdir(carpeta_origen):
        print(f"❌ Error: '{carpeta_origen}' no es una carpeta")
        return
    
    if carpeta_salida is None:
        carpeta_salida = carpeta_origen
    
    os.makedirs(carpeta_salida, exist_ok=True)
    
    # Buscar archivos PDF
    archivos_pdf = [f for f in os.listdir(carpeta_origen) if f.lower().endswith('.pdf')]
    
    if not archivos_pdf:
        print(f"⚠️  No se encontraron archivos PDF en: {carpeta_origen}")
        return
    
    print(f"\n{'='*60}")
    print(f"📁 Carpeta de origen: {carpeta_origen}")
    print(f"💾 Carpeta de destino: {carpeta_salida}")
    print(f"📄 PDFs encontrados: {len(archivos_pdf)}")
    print(f"🌐 Idioma OCR: {idioma_ocr}")
    print(f"{'='*60}\n")
    
    convertidos = 0
    errores = 0
    escaneados = 0
    normales = 0
    
    for pdf_file in archivos_pdf:
        pdf_path = os.path.join(carpeta_origen, pdf_file)
        docx_file = pdf_file.replace('.pdf', '.docx')
        docx_path = os.path.join(carpeta_salida, docx_file)
        
        # Omitir si ya existe (opcional)
        if os.path.exists(docx_path):
            print(f"⏭️  Omitiendo {pdf_file} - ya existe {docx_file}")
            continue
        
        print(f"\n📄 Procesando: {pdf_file}")
        
        # Detectar si el PDF tiene texto o es escaneado
        print(f"    🔍 Analizando PDF...")
        tiene_texto = verificar_pdf_con_texto(pdf_path)
        
        try:
            if tiene_texto:
                print(f"    ✅ PDF con texto detectable - Usando conversión rápida")
                convertir_pdf_normal(pdf_path, docx_path)
                normales += 1
                print(f"    💾 Guardado como: {docx_file}")
            else:
                print(f"    📷 PDF escaneado (solo imágenes) - Usando OCR")
                convertir_pdf_con_ocr(pdf_path, docx_path, idioma_ocr)
                escaneados += 1
                print(f"    💾 Guardado como: {docx_file}")
            
            convertidos += 1
            
        except Exception as e:
            errores += 1
            print(f"    ❌ Error: {str(e)}")
    
    # Resumen final
    print(f"\n{'='*60}")
    print(f"📊 RESUMEN DE CONVERSIÓN:")
    print(f"   ✅ Exitosos: {convertidos}")
    print(f"      - PDFs normales: {normales}")
    print(f"      - PDFs escaneados (OCR): {escaneados}")
    print(f"   ❌ Errores: {errores}")
    print(f"   📁 Ubicación: {carpeta_salida}")
    print(f"{'='*60}")

