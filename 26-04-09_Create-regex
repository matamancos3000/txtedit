    'e': '(e|é|è|ë|ê|he)',
    'i': '(i|í|ì|ï|î|hi)',
    'o': '(o|ó|ò|ö|ô|ho)',
    'u': '(u|ú|ù|ü|û|hu)',
    'n': '(n|ñ|m)',
