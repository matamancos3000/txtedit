    'hueso': '(hueso|ueso)',
}

# Sustituciones de palabras completas
sustituciones_palabras = {
    'por': '(por|x|p|para)',
    'para': '(para|pa|por)',
    'porque': '(porque|xq|pk|pq|por que|porq)',
    'que': '(que|q|ke|k)',
    'como': '(como|cómo|komo|cm)',
    'esta': '(esta|está|ta|sta)',
    'está': '(está|esta|ta|sta)',
