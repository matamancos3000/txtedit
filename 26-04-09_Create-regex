    'haber': '(haber|aber|a ver|aver)',
    'hola': '(hola|ola|hóla)',
    'hacer': '(hacer|aser|hazer)',
}

def quitar_acentos_liveperson(texto):
    """Elimina acentos pero preserva la ñ."""
    texto_nfd = unicodedata.normalize('NFD', texto)
    resultado = []
    i = 0
    while i < len(texto_nfd):
        c = texto_nfd[i]
        if c == 'n' and i + 1 < len(texto_nfd) and texto_nfd[i+1] == '\u0303':
            resultado.append('ñ')
            i += 2
            continue
        elif unicodedata.category(c) == 'Mn':
            i += 1
            continue
        else:
            resultado.append(c)
            i += 1
    return ''.join(resultado)

def aplicar_reglas_h_muda(texto):
    """Aplica reglas especiales para palabras que pueden perder la H inicial."""
    palabras = texto.split()
    resultado = []
    i = 0
    
    while i < len(palabras):
        palabra_actual = palabras[i]
        reemplazado = False
        
        if palabra_actual in reglas_h_muda:
            resultado.append(reglas_h_muda[palabra_actual])
            reemplazado = True
        elif palabra_actual.startswith('h') and len(palabra_actual) > 1:
            sin_h = palabra_actual[1:]
            if sin_h:
                resultado.append(f"({palabra_actual}|{sin_h})")
                reemplazado = True
        
        if not reemplazado:
            resultado.append(palabra_actual)
        
        i += 1
    
    return ' '.join(resultado)

def aplicar_sustituciones_palabras(texto):
    """Aplica sustituciones de palabras completas a una frase."""
    palabras = texto.split()
    resultado = []
    i = 0
    
    while i < len(palabras):
        palabra_actual = palabras[i]
        reemplazado = False
        
        if i + 1 < len(palabras):
            frase_dos_palabras = f"{palabra_actual} {palabras[i+1]}"
            if frase_dos_palabras in sustituciones_palabras:
                resultado.append(sustituciones_palabras[frase_dos_palabras])
                i += 2
                reemplazado = True
        
        if not reemplazado:
            if palabra_actual in sustituciones_palabras:
                resultado.append(sustituciones_palabras[palabra_actual])
            else:
                resultado.append(palabra_actual)
            i += 1
    
    return ' '.join(resultado)

def generar_regex_liveperson(frase, usar_sustituciones=True, usar_h_muda=True, espacios_opcionales=True):
    """
    Genera expresión regular para LivePerson.
    
    Args:
        frase: Texto a convertir en regex
        usar_sustituciones: Si True, aplica sustituciones de palabras (ej: por = x)
        usar_h_muda: Si True, aplica reglas para detectar palabras con/sin H
        espacios_opcionales: Si True, permite que los espacios sean opcionales (pueden ser espacio o nada)
    """
    frase = frase.lower().strip()
    frase = quitar_acentos_liveperson(frase)
    
    # Aplicar reglas en orden
    if usar_h_muda:
        frase = aplicar_reglas_h_muda(frase)
    
    if usar_sustituciones:
        frase = aplicar_sustituciones_palabras(frase)
    
    # Dividimos la frase en palabras
    palabras = frase.split()
    patrones_por_palabra = []
    
    for palabra in palabras:
        # Si la palabra ya es un grupo (contiene paréntesis), la usamos directamente
        if palabra.startswith('(') and palabra.endswith(')'):
            patron_palabra_completo = palabra
        else:
            # Procesamos letra por letra
            patron_palabra = ""
            for letra in palabra:
                if letra in variaciones_letras:
                    patron_palabra += variaciones_letras[letra]
                else:
                    patron_palabra += letra
            patron_palabra_completo = f"({patron_palabra})"
        
        patrones_por_palabra.append(patron_palabra_completo)
    
    # 🔥 NUEVO: Unir palabras con espacios opcionales
    if espacios_opcionales:
        # El separador puede ser espacio o nada (para detectar palabras pegadas)
        # Ej: "hola mundo" también detectará "holamundo"
        separador = r'\s*'  # 0 o más espacios (incluyendo 0)
        # También podemos permitir otros separadores comunes
        separador = r'[\s]*'  # Más explícito
    else:
        separador = r'\s+'  # 1 o más espacios (obligatorio)
    
    regex_final = separador.join(patrones_por_palabra)
    
    return regex_final

def generar_regex_con_grupos_opcionales(frase, usar_sustituciones=True, usar_h_muda=True):
    """
    🔥 NUEVO: Genera regex donde CADA PALABRA es opcional (para búsquedas flexibles)
    Útil para cuando el usuario puede omitir palabras.
    """
    regex_base = generar_regex_liveperson(frase, usar_sustituciones, usar_h_muda, espacios_opcionales=True)
    
    # Hacer que cada grupo de palabra sea opcional
    # Esto permite que falten palabras en medio de la frase
    # Ej: "hola mundo" detectará "hola", "mundo", "hola mundo"
    
    # Dividimos el regex en grupos de palabras
    # Buscamos patrones como (palabra) separados por \s*
    patron_grupos = r'\([^)]+\)'  # Encuentra (contenido)
    grupos = re.findall(patron_grupos, regex_base)
    
    if len(grupos) > 1:
        # Hacemos cada grupo opcional con ?
        grupos_opcionales = [f"{grupo}?" for grupo in grupos]
        regex_opcional = r'\s*'.join(grupos_opcionales)
        return regex_opcional
    else:
        return regex_base

