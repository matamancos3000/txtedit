def quitar_acentos_liveperson(texto):
    """Elimina acentos pero preserva la ñ."""
    texto_nfd = unicodedata.normalize('NFD', texto)
    resultado = []
    i = 0
    while i < len(texto_nfd):
        c = texto_nfd[i]
        # Si es una 'n' seguida de la tilde de la ñ (U+0303)
        if c == 'n' and i + 1 < len(texto_nfd) and texto_nfd[i+1] == '\u0303':
            resultado.append('ñ')
            i += 2
            continue
        # Si es un carácter diacrítico (acentos), lo ignoramos
        elif unicodedata.category(c) == 'Mn':
            i += 1
            continue
        else:
            resultado.append(c)
            i += 1
    return ''.join(resultado)

def aplicar_reglas_h_muda(texto):
    """
    Aplica reglas especiales para palabras que pueden perder la H inicial.
    """
    palabras = texto.split()
    resultado = []
    i = 0
    
    while i < len(palabras):
        palabra_actual = palabras[i]
        reemplazado = False
        
        # Verificar si la palabra tiene regla especial por H muda
        if palabra_actual in reglas_h_muda:
            resultado.append(reglas_h_muda[palabra_actual])
            reemplazado = True
        # Verificar si es una palabra que empieza con H (pero no está en reglas)
        elif palabra_actual.startswith('h') and len(palabra_actual) > 1:
            # Generar variación automática: con H y sin H
            sin_h = palabra_actual[1:]  # Quitar la H
            # También considerar H aspirada vs muda (para extranjerismos)
            if sin_h:
                resultado.append(f"({palabra_actual}|{sin_h})")
                reemplazado = True
        
        # Si no se aplicó ninguna regla, mantener la palabra original
        if not reemplazado:
            resultado.append(palabra_actual)
        
        i += 1
    
    return ' '.join(resultado)

def aplicar_sustituciones_palabras(texto):
    """
    Aplica sustituciones de palabras completas a una frase.
    """
    texto_original = texto
    palabras = texto.split()
    resultado = []
    i = 0
    
    while i < len(palabras):
        palabra_actual = palabras[i]
        reemplazado = False
        
        # Primero revisar frases de 2 palabras (ej: "por que", "a ver")
        if i + 1 < len(palabras):
            frase_dos_palabras = f"{palabra_actual} {palabras[i+1]}"
            if frase_dos_palabras in sustituciones_palabras:
                resultado.append(sustituciones_palabras[frase_dos_palabras])
                i += 2
                reemplazado = True
        
        # Si no fue frase de 2 palabras, revisar palabra individual
        if not reemplazado:
            if palabra_actual in sustituciones_palabras:
                resultado.append(sustituciones_palabras[palabra_actual])
            else:
                resultado.append(palabra_actual)
            i += 1
    
    return ' '.join(resultado)

def generar_regex_liveperson(frase, usar_sustituciones=True, usar_h_muda=True):
    """
    Genera expresión regular para LivePerson.
    
    Args:
        frase: Texto a convertir en regex
        usar_sustituciones: Si True, aplica sustituciones de palabras (ej: por = x)
        usar_h_muda: Si True, aplica reglas para detectar palabras con/sin H
    """
    frase = frase.lower().strip()
    frase = quitar_acentos_liveperson(frase)
    
    # Aplicar reglas en orden: primero H muda, luego sustituciones
    if usar_h_muda:
        frase = aplicar_reglas_h_muda(frase)
    
    if usar_sustituciones:
        frase = aplicar_sustituciones_palabras(frase)
    
    # Dividimos la frase en palabras
    palabras = frase.split()
    patrones_por_palabra = []
    
    for palabra in palabras:
        # Si la palabra ya es un grupo (contiene paréntesis), la usamos directamente
        if palabra.startswith('(') and palabra.endswith(')'):
            patrones_por_palabra.append(palabra)
        else:
            # Procesamos letra por letra
            patron_palabra = ""
            for letra in palabra:
                if letra in variaciones_letras:
                    patron_palabra += variaciones_letras[letra]
                else:
                    patron_palabra += letra
            patrones_por_palabra.append(f"({patron_palabra})")
    
    # Unimos las palabras con espacios flexibles
    regex_final = r'\s+'.join(patrones_por_palabra)
    
    return regex_final

