    'g': '(g|j)',
    'j': '(j|g)',
    's': '(s|z)',
    'z': '(z|s)',
    'b': '(b|v)',
    'v': '(v|b)',
    'c': '(c|k|q)',
    'k': '(k|c|q)',
    'q': '(q|c|k)',
    'y': '(y|ll)',
    'll': '(ll|y)'
}

# Reglas especiales para la H muda
reglas_h_muda = {
    'hacer': '(hacer|acer|aser|hazer|hacer)',
    'hola': '(hola|ola|hóla)',
    'hermano': '(hermano|ermano|er mano)',
