def formatear_ano_mes(fecha):
    """
    Extrae año y mes de una fecha en formato YYYY-MM
    """
    if pd.isna(fecha):
        return None
    
    try:
        # Si es string, convertir a datetime primero
        if isinstance(fecha, str):
            fecha = pd.to_datetime(fecha, errors='coerce')
        
        # Formatear como YYYY-MM
        return fecha.strftime("%Y-%m")
    except:
        return None

def calcular_total_segundos(fila):
    """
    Suma los segundos de robot y agente (maneja valores nulos)
    """
    seg_agente = fila.get("Tiempo de captura agente segundos", 0)
    seg_robot = fila.get("Tiempo de alta robot segundos", 0)
    
    # Convertir a float y manejar nulos
    try:
        seg_agente = float(seg_agente) if pd.notna(seg_agente) else 0
    except:
        seg_agente = 0
    
    try:
        seg_robot = float(seg_robot) if pd.notna(seg_robot) else 0
    except:
        seg_robot = 0
    
    total = seg_agente + seg_robot
    
    # Si el total es 0, retornar None (para no mostrar ceros cuando no hay datos)
    return total if total > 0 else None

def convertir_segundos_a_minutos_segundos(segundos):
    """
    Convierte segundos totales a formato mm:ss
    """
    if pd.isna(segundos) or segundos <= 0:
        return None
    
    minutos = int(segundos // 60)
    segs = int(segundos % 60)
    
    return f"{minutos:02d}:{segs:02d}"

