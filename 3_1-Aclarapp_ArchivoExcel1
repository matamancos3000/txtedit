def crear_hoja_comparativa_agentes(workbook, df):
    """
    Crea hoja 'Comparativa Agentes' con dos tablas:
    1. Por Site (con barras de datos degradadas rojas)
    2. Por Nombre Agente (con Site, Supervisor y Skill)
    CON MEJORAS: Agente|Site|Supervisor|Skill|08-dic|09-dic|...|22-ene|Total
    Y TOTAL DEL DÍA al final con barras de datos rojas
    """
    logger.info("\n📊 CREANDO HOJA 'COMPARATIVA AGENTES' MEJORADA...")
    
    # Crear nueva hoja
    ws = workbook.create_sheet(title="Comparativa Agentes")
    
    # Verificar que tenemos los datos necesarios
    required_cols = ["Fecha", "Site", "Nombre Agente", "Supervisor", "Skill"]
    missing_cols = [col for col in required_cols if col not in df.columns]
    
    if missing_cols:
        logger.warning(f"⚠️ Columnas faltantes para crear hoja 'Comparativa Agentes': {missing_cols}")
        # Intentar con columnas mínimas
        required_cols_min = ["Fecha", "Site", "Nombre Agente"]
        missing_cols_min = [col for col in required_cols_min if col not in df.columns]
        
        if missing_cols_min:
            ws["A1"] = f"Datos insuficientes. Faltan: {', '.join(missing_cols_min)}"
            return
        else:
            # Si faltan Supervisor o Skill, crear columnas vacías
            if "Supervisor" not in df.columns:
                df["Supervisor"] = "Sin Supervisor"
            if "Skill" not in df.columns:
                df["Skill"] = "Sin Skill"
            logger.info("✓ Columnas Supervisor y/o Skill creadas como vacías")
    
    # Crear copia del DataFrame para procesar
    df_comparativa = df[["Fecha", "Site", "Nombre Agente", "Supervisor", "Skill"]].copy()
    
    # Extraer solo la fecha (sin hora) y convertir a formato dia-mes
    df_comparativa["Fecha"] = pd.to_datetime(df_comparativa["Fecha"]).dt.date
    
    # Ordenar por fecha
    df_comparativa = df_comparativa.sort_values("Fecha")
    
    # Obtener todas las fechas únicas y formatearlas
    fechas_unicas = sorted(df_comparativa["Fecha"].unique())
    fechas_formateadas = [fecha.strftime("%d-%b") for fecha in fechas_unicas]
    
    # Reemplazar valores NaN
    df_comparativa["Site"] = df_comparativa["Site"].fillna("Sin Site")
    df_comparativa["Nombre Agente"] = df_comparativa["Nombre Agente"].fillna("Sin Agente")
    df_comparativa["Supervisor"] = df_comparativa["Supervisor"].fillna("Sin Supervisor")
    df_comparativa["Skill"] = df_comparativa["Skill"].fillna("Sin Skill")
    
    # ============================================
    # TABLA 1: POR SITE (CON BARRAS DE DATOS DEGRADADAS ROJAS)
    # ============================================
    logger.info("📈 Creando tabla por Site...")
    
    # Crear tabla pivote para Site
    pivot_site = pd.pivot_table(
        df_comparativa,
        index="Site",
        columns="Fecha",
        aggfunc="size",
        fill_value=0
    )
    
    # Reordenar columnas por fecha
    pivot_site = pivot_site[fechas_unicas]
    
    # Renombrar columnas con formato dia-mes
    pivot_site.columns = fechas_formateadas
    
    # Calcular total por site
    pivot_site["Total"] = pivot_site.sum(axis=1)
    
    # Ordenar por total descendente
    pivot_site = pivot_site.sort_values("Total", ascending=False)
    
    # Escribir tabla por Site en Excel
    fila_actual = 1
    
    # Título de la tabla
    ws.cell(row=fila_actual, column=1, value="COMPARATIVA POR SITE")
    ws.cell(row=fila_actual, column=1).font = Font(name="Univers Next for HSBC Light", size=14, bold=True, color="C00000")
    fila_actual += 1
    
    # Encabezados de tabla
    ws.cell(row=fila_actual, column=1, value="Site")
    for i, fecha in enumerate(fechas_formateadas, start=2):
        ws.cell(row=fila_actual, column=i, value=fecha)
    ws.cell(row=fila_actual, column=len(fechas_formateadas)+2, value="Total")
    
    # Formato encabezados
    for col in range(1, len(fechas_formateadas)+3):
        celda = ws.cell(row=fila_actual, column=col)
        celda.fill = PatternFill(start_color="C00000", end_color="C00000", fill_type="solid")
        celda.font = Font(name="Univers Next for HSBC Light", size=11, bold=True, color="FFFFFF")
        celda.alignment = Alignment(horizontal="center", vertical="center")
    
    fila_actual += 1
    
    # Inicio datos Site (para aplicar formatos después)
    inicio_datos_site = fila_actual
    
    # Escribir datos de Site
    for site_idx, (site, fila) in enumerate(pivot_site.iterrows(), start=0):
        ws.cell(row=fila_actual, column=1, value=site)
        
        # Datos por fecha
        for fecha_idx, fecha in enumerate(fechas_formateadas, start=2):
            valor = int(fila[fecha])
            ws.cell(row=fila_actual, column=fecha_idx, value=valor)
        
        # Total
        ws.cell(row=fila_actual, column=len(fechas_formateadas)+2, value=int(fila["Total"]))
        fila_actual += 1
    
    # Guardar posición final de tabla Site
    fin_tabla_site = fila_actual - 1
    num_sites = len(pivot_site)
    
    # ============================================
    # APLICAR FORMATOS CONDICIONALES A TABLA SITE
    # ============================================
    logger.info("🎨 Aplicando formatos condicionales a tabla Site...")
    
    # Definir regla de barras de datos rojas
    data_bar_rule_site = DataBarRule(
        start_type="min",
        start_value=0,
        end_type="max",
        end_value=None,
        color="FF6666"  # Rojo claro para el degradado
    )
    
    # Definir regla para total (más oscura)
    data_bar_total_rule_site = DataBarRule(
        start_type="min",
        start_value=0,
        end_type="max",
        end_value=None,
        color="C00000"  # Rojo HSBC más oscuro
    )
    
    # Aplicar barras de datos a todas las columnas numéricas de Site
    for col_idx in range(2, len(fechas_formateadas) + 3):  # Desde columna B hasta Total
        col_letter = get_column_letter(col_idx)
        rango_site = f"{col_letter}{inicio_datos_site}:{col_letter}{fin_tabla_site}"
        
        # Aplicar formato diferente para columna Total
        if col_idx == len(fechas_formateadas) + 2:  # Columna Total
            ws.conditional_formatting.add(rango_site, data_bar_total_rule_site)
        else:
            ws.conditional_formatting.add(rango_site, data_bar_rule_site)
    
    # ============================================
    # TABLA 2: POR NOMBRE AGENTE (MEJORADA)
    # ============================================
    logger.info("👤 Creando tabla por Nombre Agente (MEJORADA)...")
    
    # Crear una tabla pivote más compleja que incluya Site, Supervisor y Skill
    # Primero, crear un DataFrame único por agente con su Site, Supervisor y Skill
    agentes_info = df_comparativa.groupby("Nombre Agente").agg({
        "Site": lambda x: x.mode()[0] if len(x.mode()) > 0 else "Sin Site",
        "Supervisor": lambda x: x.mode()[0] if len(x.mode()) > 0 else "Sin Supervisor",
        "Skill": lambda x: x.mode()[0] if len(x.mode()) > 0 else "Sin Skill"
    }).reset_index()
    
    # Crear tabla pivote para conteo por agente
    pivot_counts = pd.pivot_table(
        df_comparativa,
        index="Nombre Agente",
        columns="Fecha",
        aggfunc="size",
        fill_value=0
    )
    
    # Reordenar columnas por fecha
    pivot_counts = pivot_counts[fechas_unicas]
    
    # Renombrar columnas con formato dia-mes
    pivot_counts.columns = fechas_formateadas
    
    # Combinar la información de agentes con los conteos
    pivot_agente = agentes_info.merge(pivot_counts, on="Nombre Agente", how="left")
    
    # Calcular total por agente (suma de todas las fechas)
    pivot_agente["Total"] = pivot_agente[fechas_formateadas].sum(axis=1)
    
    # Ordenar por total descendente
    pivot_agente = pivot_agente.sort_values("Total", ascending=False)
    
    # Dejar espacio entre tablas
    fila_actual += 3
    
    # Título de la tabla
    ws.cell(row=fila_actual, column=1, value="COMPARATIVA POR AGENTE (CON SITE, SUPERVISOR Y SKILL)")
    ws.cell(row=fila_actual, column=1).font = Font(name="Univers Next for HSBC Light", size=14, bold=True, color="C00000")
    fila_actual += 1
    
    # Encabezados de tabla MEJORADOS
    ws.cell(row=fila_actual, column=1, value="Agente")
    ws.cell(row=fila_actual, column=2, value="Site")
    ws.cell(row=fila_actual, column=3, value="Supervisor")
    ws.cell(row=fila_actual, column=4, value="Skill")
    
    # Encabezados de fechas (empezando desde columna 5)
    for i, fecha in enumerate(fechas_formateadas, start=5):
        ws.cell(row=fila_actual, column=i, value=fecha)
    
    # Encabezado de Total
    total_col = len(fechas_formateadas) + 5  # +5 porque ahora tenemos 4 columnas de texto
    ws.cell(row=fila_actual, column=total_col, value="Total")
    
    # Formato encabezados
    for col in range(1, total_col + 1):
        celda = ws.cell(row=fila_actual, column=col)
        celda.fill = PatternFill(start_color="C00000", end_color="C00000", fill_type="solid")
        celda.font = Font(name="Univers Next for HSBC Light", size=11, bold=True, color="FFFFFF")
        celda.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
    
    fila_actual += 1
    
    # Inicio de datos de agentes (para aplicar formatos después)
    inicio_datos_agente = fila_actual
    
    # Escribir datos de Agente MEJORADOS
    for agente_idx, row in pivot_agente.iterrows():
        # Agente, Site, Supervisor, Skill
        ws.cell(row=fila_actual, column=1, value=row["Nombre Agente"])
        ws.cell(row=fila_actual, column=2, value=row["Site"])
        ws.cell(row=fila_actual, column=3, value=row["Supervisor"])
        ws.cell(row=fila_actual, column=4, value=row["Skill"])
        
        # Datos por fecha
        for fecha_idx, fecha in enumerate(fechas_formateadas, start=5):
            valor = int(row[fecha]) if fecha in row else 0
            ws.cell(row=fila_actual, column=fecha_idx, value=valor)
        
        # Total
        ws.cell(row=fila_actual, column=total_col, value=int(row["Total"]))
        fila_actual += 1
    
    # Guardar posición final de tabla Agente
    fin_tabla_agente = fila_actual - 1
    num_agentes = len(pivot_agente)
    
    # ============================================
    # AGREGAR FILA DE "TOTAL DEL DÍA" AL FINAL
    # ============================================
    logger.info("➕ Agregando fila de 'Total del día'...")
    
    # Calcular totales por día (suma de todos los agentes por fecha)
    totales_dia = {}
    for fecha in fechas_formateadas:
        totales_dia[fecha] = pivot_agente[fecha].sum()
    
    # Calcular total general (suma de todos los totales)
    total_general = sum(totales_dia.values())
    
    # Agregar fila de "Total del día"
    total_dia_fila = fila_actual
    ws.cell(row=total_dia_fila, column=1, value="TOTAL DEL DÍA")
    
    # Site, Supervisor y Skill vacíos o con guión
    ws.cell(row=total_dia_fila, column=2, value="-")
    ws.cell(row=total_dia_fila, column=3, value="-")
    ws.cell(row=total_dia_fila, column=4, value="-")
    
    # Totales por día
    for fecha_idx, fecha in enumerate(fechas_formateadas, start=5):
        ws.cell(row=total_dia_fila, column=fecha_idx, value=totales_dia[fecha])
    
    # Total general
    ws.cell(row=total_dia_fila, column=total_col, value=total_general)
    
    # Aplicar formato ESPECIAL a la fila "Total del día"
    # Fondo negro, letra blanca, negrita en TODAS las columnas
    black_fill = PatternFill(start_color="000000", end_color="000000", fill_type="solid")
    white_font = Font(name="Univers Next for HSBC Light", size=11, bold=True, color="FFFFFF")
    center_align = Alignment(horizontal="center", vertical="center")
    
    for col in range(1, total_col + 1):
        celda = ws.cell(row=total_dia_fila, column=col)
        celda.fill = black_fill
        celda.font = white_font
        celda.alignment = center_align
    
    # Marcar posición final incluyendo "Total del día"
    fin_tabla_con_total = fila_actual
    
    # ============================================
    # APLICAR FORMATOS CONDICIONALES A TABLA AGENTES
    # ============================================
    logger.info("🎨 Aplicando formatos condicionales a tabla Agente...")
    
    # Definir regla de barras de datos rojas para agentes
    data_bar_rule_agente = DataBarRule(
        start_type="min",
        start_value=0,
        end_type="max",
        end_value=None,
        color="FF6666"  # Rojo claro para el degradado
    )
    
    # Definir regla para total de agentes (más oscura)
    data_bar_total_rule_agente = DataBarRule(
        start_type="min",
        start_value=0,
        end_type="max",
        end_value=None,
        color="C00000"  # Rojo HSBC más oscuro
    )
    
    # Definir regla especial de barras de datos NEGRAS para "TOTAL DEL DÍA"
    data_bar_black_rule = DataBarRule(
        start_type="min",
        start_value=0,
        end_type="max",
        end_value=None,
        color="000000"  # NEGRO para "Total del día"
